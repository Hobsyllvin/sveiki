  "sections": [
    {
      "format": "narration",
      "title": "Satikšanās",
      "sentences": [
        {
          "id": "s1",
          "speaker": "Narrator",
          "target": "Pēteris un Anna satiekas kafejnīcā Vecrīgā.",
          "tokens": [
            { "lv": "Pēteris", "gloss": "Pēteris", "lemma": "Pēteris", "pos": "propn", "note": "nom." },
            { "lv": "un", "gloss": "and", "lemma": "un", "pos": "conj" },
            { "lv": "Anna", "gloss": "Anna", "lemma": "Anna", "pos": "propn", "note": "nom." },
            { "lv": "satiekas", "gloss": "meet", "lemma": "satikties", "pos": "verb", "note": "refl. form, reciprocal; 3 pres." },
            { "lv": "kafejnīcā", "gloss": "in-café", "lemma": "kafejnīca", "pos": "noun", "note": "loc." },
            { "lv": "Vecrīgā", "gloss": "in-Vecrīga", "lemma": "Vecrīga", "pos": "propn", "note": "loc.", "punct": "." }
          ],
          "natural": "Pēteris and Anna meet in a café in Riga's Old Town.",
          "audio": "lv-a1-03-s1.mp3",
          "audioApproved": false
        }
      ]
    },
    {
      "format": "dialogue",
      "title": "Sveicieni un vieta",
      "sentences": [
        {
          "id": "s2",
          "speaker": "Pēteris",
          "target": "Sveika, Anna! Prieks tevi redzēt.",
          "tokens": [
            { "lv": "Sveika", "gloss": "hello", "lemma": "sveiks", "pos": "interj", "note": "fem. addressee", "punct": "," },
            { "lv": "Anna", "gloss": "Anna", "lemma": "Anna", "pos": "propn", "note": "voc.", "punct": "!" },
            { "lv": "Prieks", "gloss": "joy", "lemma": "prieks", "pos": "noun", "note": "nom.; prieks redzēt = nice to see" },
            { "lv": "tevi", "gloss": "you", "lemma": "tu", "pos": "pron", "note": "acc." },
            { "lv": "redzēt", "gloss": "to-see", "lemma": "redzēt", "pos": "verb", "note": "inf.", "punct": "." }
          ],
          "natural": "Hello, Anna! Nice to see you.",
          "audio": "lv-a1-03-s2.mp3",
          "audioApproved": false
        },
        {
          "id": "s3",
          "speaker": "Anna",
          "target": "Sveiks, Pēteri! Man arī.",
          "tokens": [
            { "lv": "Sveiks", "gloss": "hello", "lemma": "sveiks", "pos": "interj", "note": "masc. addressee", "punct": "," },
            { "lv": "Pēteri", "gloss": "Pēteris", "lemma": "Pēteris", "pos": "propn", "note": "voc.", "punct": "!" },
            { "lv": "Man", "gloss": "to-me", "lemma": "es", "pos": "pron", "note": "dat." },
            { "lv": "arī", "gloss": "also", "lemma": "arī", "pos": "adv", "punct": "." }
          ],
          "natural": "Hello, Pēteris! You too.",
          "audio": "lv-a1-03-s3.mp3",
          "audioApproved": false
        },
        {
          "id": "s4",
          "speaker": "Anna",
          "target": "Šī ir ļoti jauka kafejnīca.",
          "tokens": [
            { "lv": "Šī", "gloss": "this", "lemma": "šis", "pos": "pron", "note": "demonstr.; fem. nom." },
            { "lv": "ir", "gloss": "is", "lemma": "būt", "pos": "verb", "note": "3 pres." },
            { "lv": "ļoti", "gloss": "very", "lemma": "ļoti", "pos": "adv" },
            { "lv": "jauka", "gloss": "nice", "lemma": "jauks", "pos": "adj", "note": "fem. nom." },
            { "lv": "kafejnīca", "gloss": "café", "lemma": "kafejnīca", "pos": "noun", "note": "nom.", "punct": "." }
          ],
          "natural": "This is a very nice café.",
          "audio": "lv-a1-03-s4.mp3",
          "audioApproved": false
        },
        {
          "id": "s5",
          "speaker": "Pēteris",
          "target": "Jā, es šeit nāku bieži. Vai tu gribi sēdēt pie loga?",
          "tokens": [
            { "lv": "Jā", "gloss": "yes", "lemma": "jā", "pos": "interj", "punct": "," },
            { "lv": "es", "gloss": "I", "lemma": "es", "pos": "pron" },
            { "lv": "šeit", "gloss": "here", "lemma": "šeit", "pos": "adv" },
            { "lv": "nāku", "gloss": "come", "lemma": "nākt", "pos": "verb", "note": "1sg pres." },
            { "lv": "bieži", "gloss": "often", "lemma": "bieži", "pos": "adv", "punct": "." },
            { "lv": "Vai", "gloss": "whether", "lemma": "vai", "pos": "part", "note": "yes/no question particle" },
            { "lv": "tu", "gloss": "you", "lemma": "tu", "pos": "pron", "note": "nom." },
            { "lv": "gribi", "gloss": "want", "lemma": "gribēt", "pos": "verb", "note": "2sg pres." },
            { "lv": "sēdēt", "gloss": "to-sit", "lemma": "sēdēt", "pos": "verb", "note": "inf." },
            { "lv": "pie", "gloss": "at", "lemma": "pie", "pos": "prep", "note": "+ gen.; here 'by'" },
            { "lv": "loga", "gloss": "window", "lemma": "logs", "pos": "noun", "note": "gen. after pie", "punct": "?" }
          ],
          "natural": "Yes, I come here often. Do you want to sit by the window?",
          "audio": "lv-a1-03-s5.mp3",
          "audioApproved": false
        },
        {
          "id": "s6",
          "speaker": "Anna",
          "target": "Jā! Šeit ir brīvs galds.",
          "tokens": [
            { "lv": "Jā", "gloss": "yes", "lemma": "jā", "pos": "interj", "punct": "!" },
            { "lv": "Šeit", "gloss": "here", "lemma": "šeit", "pos": "adv" },
            { "lv": "ir", "gloss": "is", "lemma": "būt", "pos": "verb", "note": "3 pres." },
            { "lv": "brīvs", "gloss": "free", "lemma": "brīvs", "pos": "adj", "note": "masc. nom." },
            { "lv": "galds", "gloss": "table", "lemma": "galds", "pos": "noun", "note": "nom.", "punct": "." }
          ],
          "natural": "Yes! There's a free table here.",
          "audio": "lv-a1-03-s6.mp3",
          "audioApproved": false
        }
      ]
    },
    {
      "format": "dialogue",
      "title": "Ko dzert",
      "sentences": [
        {
          "id": "s7",
          "speaker": "Pēteris",
          "target": "Ko tu gribi dzert?",
          "tokens": [
            { "lv": "Ko", "gloss": "what", "lemma": "kas", "pos": "pron", "note": "acc." },
            { "lv": "tu", "gloss": "you", "lemma": "tu", "pos": "pron", "note": "nom." },
            { "lv": "gribi", "gloss": "want", "lemma": "gribēt", "pos": "verb", "note": "2sg pres." },
            { "lv": "dzert", "gloss": "to-drink", "lemma": "dzert", "pos": "verb", "note": "inf.", "punct": "?" }
          ],
          "natural": "What do you want to drink?",
          "audio": "lv-a1-03-s7.mp3",
          "audioApproved": false
        },
        {
          "id": "s8",
          "speaker": "Anna",
          "target": "Es gribu kafiju. Un tu?",
          "tokens": [
            { "lv": "Es", "gloss": "I", "lemma": "es", "pos": "pron" },
            { "lv": "gribu", "gloss": "want", "lemma": "gribēt", "pos": "verb", "note": "1sg pres." },
            { "lv": "kafiju", "gloss": "coffee", "lemma": "kafija", "pos": "noun", "note": "acc.", "punct": "." },
            { "lv": "Un", "gloss": "and", "lemma": "un", "pos": "conj" },
            { "lv": "tu", "gloss": "you", "lemma": "tu", "pos": "pron", "note": "nom.", "punct": "?" }
          ],
          "natural": "I want coffee. And you?",
          "audio": "lv-a1-03-s8.mp3",
          "audioApproved": false
        },
        {
          "id": "s9",
          "speaker": "Pēteris",
          "target": "Es dzeru tēju. Kafija man negaršo.",
          "tokens": [
            { "lv": "Es", "gloss": "I", "lemma": "es", "pos": "pron" },
            { "lv": "dzeru", "gloss": "drink", "lemma": "dzert", "pos": "verb", "note": "1sg pres." },
            { "lv": "tēju", "gloss": "tea", "lemma": "tēja", "pos": "noun", "note": "acc.", "punct": "." },
            { "lv": "Kafija", "gloss": "coffee", "lemma": "kafija", "pos": "noun", "note": "nom." },
            { "lv": "man", "gloss": "to-me", "lemma": "es", "pos": "pron", "note": "dat." },
            { "lv": "negaršo", "gloss": "not-tastes", "lemma": "garšot", "pos": "verb", "note": "neg. 3 pres.; dat. construction", "punct": "." }
          ],
          "natural": "I'm drinking tea. I don't like coffee.",
          "audio": "lv-a1-03-s9.mp3",
          "audioApproved": false
        },
        {
          "id": "s10",
          "speaker": "Anna",
          "target": "Ko? Tev negaršo kafija? Cik skumja dzīve!",
          "tokens": [
            { "lv": "Ko", "gloss": "what", "lemma": "kas", "pos": "pron", "note": "acc.", "punct": "?" },
            { "lv": "Tev", "gloss": "to-you", "lemma": "tu", "pos": "pron", "note": "dat." },
            { "lv": "negaršo", "gloss": "not-tastes", "lemma": "garšot", "pos": "verb", "note": "neg. 3 pres.; dat. construction" },
            { "lv": "kafija", "gloss": "coffee", "lemma": "kafija", "pos": "noun", "note": "nom.", "punct": "?" },
            { "lv": "Cik", "gloss": "how", "lemma": "cik", "pos": "adv", "note": "cik + adj. = how" },
            { "lv": "skumja", "gloss": "sad", "lemma": "skumjs", "pos": "adj", "note": "fem. nom." },
            { "lv": "dzīve", "gloss": "life", "lemma": "dzīve", "pos": "noun", "note": "nom.", "punct": "!" }
          ],
          "natural": "What? You don't like coffee? What a sad life!",
          "audio": "lv-a1-03-s10.mp3",
          "audioApproved": false
        },
        {
          "id": "s11",
          "speaker": "Pēteris",
          "target": "Haha, tu pūt pīlītes! Tēja ir vislabākā!",
          "tokens": [
            { "lv": "Haha", "gloss": "haha", "lemma": "haha", "pos": "interj", "punct": "," },
            { "lv": "tu", "gloss": "you", "lemma": "tu", "pos": "pron", "note": "nom." },
            { "lv": "pūt", "gloss": "blow", "lemma": "pūst", "pos": "verb", "note": "2sg pres." },
            { "lv": "pīlītes", "gloss": "little-ducks", "lemma": "pīlīte", "pos": "noun", "note": "acc. pl.; dim.; idiom = talk nonsense", "punct": "!" },
            { "lv": "Tēja", "gloss": "tea", "lemma": "tēja", "pos": "noun", "note": "nom." },
            { "lv": "ir", "gloss": "is", "lemma": "būt", "pos": "verb", "note": "3 pres." },
            { "lv": "vislabākā", "gloss": "best", "lemma": "labs", "pos": "adj", "note": "superl. def. fem. nom.", "punct": "!" }
          ],
          "natural": "Haha, you're talking nonsense! Tea is the best!",
          "audio": "lv-a1-03-s11.mp3",
          "audioApproved": false
        },
        {
          "id": "s12",
          "speaker": "Anna",
          "target": "No rīta man vienmēr vajag kafiju.",
          "tokens": [
            { "lv": "No", "gloss": "from", "lemma": "no", "pos": "prep", "note": "+ gen." },
            { "lv": "rīta", "gloss": "morning", "lemma": "rīts", "pos": "noun", "note": "gen. after no" },
            { "lv": "man", "gloss": "to-me", "lemma": "es", "pos": "pron", "note": "dat." },
            { "lv": "vienmēr", "gloss": "always", "lemma": "vienmēr", "pos": "adv" },
            { "lv": "vajag", "gloss": "needs", "lemma": "vajadzēt", "pos": "verb", "note": "3 pres.; man vajag = to-me needs" },
            { "lv": "kafiju", "gloss": "coffee", "lemma": "kafija", "pos": "noun", "note": "acc.", "punct": "." }
          ],
          "natural": "In the morning I always need coffee.",
          "audio": "lv-a1-03-s12.mp3",
          "audioApproved": false
        }
      ]
    },
    {
      "format": "dialogue",
      "title": "Kūkas",
      "sentences": [
        {
          "id": "s13",
          "speaker": "Pēteris",
          "target": "Redzi? Tā ir skumja dzīve, haha! Vai tu gribi kūku? Šeit ir ļoti garšīgas kūkas. Es iesaku siera kūku.",
          "tokens": [
            { "lv": "Redzi", "gloss": "see", "lemma": "redzēt", "pos": "verb", "note": "2sg pres.", "punct": "?" },
            { "lv": "Tā", "gloss": "that", "lemma": "tas", "pos": "pron", "note": "demonstr.; fem. nom." },
            { "lv": "ir", "gloss": "is", "lemma": "būt", "pos": "verb", "note": "3 pres." },
            { "lv": "skumja", "gloss": "sad", "lemma": "skumjs", "pos": "adj", "note": "fem. nom." },
            { "lv": "dzīve", "gloss": "life", "lemma": "dzīve", "pos": "noun", "note": "nom.", "punct": "," },
            { "lv": "haha", "gloss": "haha", "lemma": "haha", "pos": "interj", "punct": "!" },
            { "lv": "Vai", "gloss": "whether", "lemma": "vai", "pos": "part", "note": "yes/no question particle" },
            { "lv": "tu", "gloss": "you", "lemma": "tu", "pos": "pron", "note": "nom." },
            { "lv": "gribi", "gloss": "want", "lemma": "gribēt", "pos": "verb", "note": "2sg pres." },
            { "lv": "kūku", "gloss": "cake", "lemma": "kūka", "pos": "noun", "note": "acc.", "punct": "?" },
            { "lv": "Šeit", "gloss": "here", "lemma": "šeit", "pos": "adv" },
            { "lv": "ir", "gloss": "are", "lemma": "būt", "pos": "verb", "note": "3 pres. pl." },
            { "lv": "ļoti", "gloss": "very", "lemma": "ļoti", "pos": "adv" },
            { "lv": "garšīgas", "gloss": "tasty", "lemma": "garšīgs", "pos": "adj", "note": "fem. nom. pl." },
            { "lv": "kūkas", "gloss": "cakes", "lemma": "kūka", "pos": "noun", "note": "nom. pl.", "punct": "." },
            { "lv": "Es", "gloss": "I", "lemma": "es", "pos": "pron" },
            { "lv": "iesaku", "gloss": "recommend", "lemma": "ieteikt", "pos": "verb", "note": "1sg pres." },
            { "lv": "siera", "gloss": "cheese", "lemma": "siers", "pos": "noun", "note": "gen.; siera kūka = cheesecake" },
            { "lv": "kūku", "gloss": "cake", "lemma": "kūka", "pos": "noun", "note": "acc.", "punct": "." }
          ],
          "natural": "See? That is a sad life, haha! Do you want cake? The cakes here are very tasty. I recommend the cheesecake.",
          "audio": "lv-a1-03-s13.mp3",
          "audioApproved": false
        },
        {
          "id": "s14",
          "speaker": "Anna",
          "target": "Tas skan lieliski! Es ļoti mīlu kūkas.",
          "tokens": [
            { "lv": "Tas", "gloss": "that", "lemma": "tas", "pos": "pron", "note": "demonstr.; masc. nom." },
            { "lv": "skan", "gloss": "sounds", "lemma": "skanēt", "pos": "verb", "note": "3 pres." },
            { "lv": "lieliski", "gloss": "wonderful", "lemma": "lieliski", "pos": "adv", "punct": "!" },
            { "lv": "Es", "gloss": "I", "lemma": "es", "pos": "pron" },
            { "lv": "ļoti", "gloss": "very", "lemma": "ļoti", "pos": "adv" },
            { "lv": "mīlu", "gloss": "love", "lemma": "mīlēt", "pos": "verb", "note": "1sg pres." },
            { "lv": "kūkas", "gloss": "cakes", "lemma": "kūka", "pos": "noun", "note": "acc. pl.", "punct": "." }
          ],
          "natural": "That sounds wonderful! I love cakes.",
          "audio": "lv-a1-03-s14.mp3",
          "audioApproved": false
        }
      ]
    },
    {
      "format": "narration",
      "title": "Viesmīlis nāk",
      "sentences": [
        {
          "id": "s15",
          "speaker": "Narrator",
          "target": "Nāk viesmīlis.",
          "tokens": [
            { "lv": "Nāk", "gloss": "comes", "lemma": "nākt", "pos": "verb", "note": "3 pres." },
            { "lv": "viesmīlis", "gloss": "waiter", "lemma": "viesmīlis", "pos": "noun", "note": "masc. nom.", "punct": "." }
          ],
          "natural": "The waiter is coming.",
          "audio": "lv-a1-03-s15.mp3",
          "audioApproved": false
        }
      ]
    },
    {
      "format": "dialogue",
      "title": "Pasūtījums",
      "sentences": [
        {
          "id": "s16",
          "speaker": "Waiter",
          "target": "Labdien! Ko jūs vēlaties?",
          "tokens": [
            { "lv": "Labdien", "gloss": "good-day", "lemma": "labdien", "pos": "interj", "punct": "!" },
            { "lv": "Ko", "gloss": "what", "lemma": "kas", "pos": "pron", "note": "acc." },
            { "lv": "jūs", "gloss": "you", "lemma": "jūs", "pos": "pron", "note": "nom. pl./polite" },
            { "lv": "vēlaties", "gloss": "wish", "lemma": "vēlēties", "pos": "verb", "note": "refl. form, non-refl. sense; 2pl pres.", "punct": "?" }
          ],
          "natural": "Hello! What would you like?",
          "audio": "lv-a1-03-s16.mp3",
          "audioApproved": false
        },
        {
          "id": "s17",
          "speaker": "Pēteris",
          "target": "Vienu kafiju, vienu tēju un divas siera kūkas, lūdzu.",
          "tokens": [
            { "lv": "Vienu", "gloss": "one", "lemma": "viens", "pos": "num", "note": "acc. fem." },
            { "lv": "kafiju", "gloss": "coffee", "lemma": "kafija", "pos": "noun", "note": "acc.", "punct": "," },
            { "lv": "vienu", "gloss": "one", "lemma": "viens", "pos": "num", "note": "acc. fem." },
            { "lv": "tēju", "gloss": "tea", "lemma": "tēja", "pos": "noun", "note": "acc." },
            { "lv": "un", "gloss": "and", "lemma": "un", "pos": "conj" },
            { "lv": "divas", "gloss": "two", "lemma": "divi", "pos": "num", "note": "acc. fem. pl." },
            { "lv": "siera", "gloss": "cheese", "lemma": "siers", "pos": "noun", "note": "gen.; siera kūka = cheesecake" },
            { "lv": "kūkas", "gloss": "cakes", "lemma": "kūka", "pos": "noun", "note": "acc. pl.", "punct": "," },
            { "lv": "lūdzu", "gloss": "please", "lemma": "lūdzu", "pos": "part", "note": "lit. 'I ask'; fixed politeness form", "punct": "." }
          ],
          "natural": "One coffee, one tea and two cheesecakes, please.",
          "audio": "lv-a1-03-s17.mp3",
          "audioApproved": false
        },
        {
          "id": "s18",
          "speaker": "Waiter",
          "target": "Kādu tēju jūs vēlaties?",
          "tokens": [
            { "lv": "Kādu", "gloss": "what-kind", "lemma": "kāds", "pos": "pron", "note": "interrog.; acc. fem." },
            { "lv": "tēju", "gloss": "tea", "lemma": "tēja", "pos": "noun", "note": "acc." },
            { "lv": "jūs", "gloss": "you", "lemma": "jūs", "pos": "pron", "note": "nom. pl./polite" },
            { "lv": "vēlaties", "gloss": "wish", "lemma": "vēlēties", "pos": "verb", "note": "refl. form, non-refl. sense; 2pl pres.", "punct": "?" }
          ],
          "natural": "Which tea would you like?",
          "audio": "lv-a1-03-s18.mp3",
          "audioApproved": false
        },
        {
          "id": "s19",
          "speaker": "Pēteris",
          "target": "Zaļo tēju, lūdzu.",
          "tokens": [
            { "lv": "Zaļo", "gloss": "green", "lemma": "zaļš", "pos": "adj", "note": "def. adj.; acc. fem." },
            { "lv": "tēju", "gloss": "tea", "lemma": "tēja", "pos": "noun", "note": "acc.", "punct": "," },
            { "lv": "lūdzu", "gloss": "please", "lemma": "lūdzu", "pos": "part", "note": "lit. 'I ask'; fixed politeness form", "punct": "." }
          ],
          "natural": "Green tea, please.",
          "audio": "lv-a1-03-s19.mp3",
          "audioApproved": false
        },
        {
          "id": "s20",
          "speaker": "Waiter",
          "target": "Un kafiju ar govs pienu vai auzu pienu?",
          "tokens": [
            { "lv": "Un", "gloss": "and", "lemma": "un", "pos": "conj" },
